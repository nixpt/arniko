/target/

# dejavue: local-only artifacts
.dejavue/fts.db
.dejavue/*.tmp
.dejavue/.first-use
.dejavue/ingested.lock
.dejavue/.locks/
.dejavue/embeddings.jsonl
.dejavue/embedder_circuit.json
.dejavue/timeline.jsonl.bak-*


# khukuri secrets/persistence (fleet-gitignored)
.khukuri/

# --- scratch / temp files added by tooling ---
# Ignored across both crush-ast and arniko to keep `git status` quiet
# when build / iteration loops emit ad-hoc scratch artifacts.
tcp_loopback.rs.bak
.newnmv
command.sh

# Agent worktrees + per-agent session state (zorro precedent).
# Worktrees are created at .claude/worktrees/<name>/ and must never be committed.
.claude/

# ── agent/MCP artifacts — never commit ──────────────────────────────────────
# worktree-setup SEEDS a per-agent .mcp.json into every dispatched worktree,
# carrying the live joker-mcp JWT_SECRET so each horse posts under its own
# AGENT_NAME. That file must never be committed. It is exactly how a live
# secret reached nixpt/nerve-mcp (729f370) and water-spider before it.
#
# Note the glob is *mcp*.json, NOT *.mcp.json — the narrow form does not match
# `mcp_servers.json`, which is the filename that actually leaked. Do not narrow.
/.mcp.json
/.dispatch/
/.claude/
.claude/settings.local.json
.jagent/*.db
.jagent/*.db-shm
.jagent/*.db-wal
.jagent/*.db-journal
.jagent/*.lock
.jagent/*.sock
.jagent/cache/
.jagent/mcp/
.jagent/*mcp*.json
.khukuri/
${SECURE_ENV_DB_PATH}*

# Generic secret-shaped files — defense in depth.
*.env
.env.*
!.env.example
*.pem
*.key
*.p12
id_rsa*
id_ed25519*
id_ecdsa*
credentials*.json
.netrc
secrets.json

# Fleet agent worktrees (kitchen / agent-launch) live under .jagent/worktrees/.
.jagent/worktrees/
